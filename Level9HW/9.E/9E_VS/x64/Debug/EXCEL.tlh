      virtual HRESULT __stdcall raw_MouseMove (
        /*[in]*/ long Button,
        /*[in]*/ long Shift,
        /*[in]*/ long x,
        /*[in]*/ long y ) = 0;
      virtual HRESULT __stdcall raw_BeforeRightClick (
        /*[in,out]*/ VARIANT_BOOL * Cancel ) = 0;
      virtual HRESULT __stdcall raw_DragPlot ( ) = 0;
      virtual HRESULT __stdcall raw_DragOver ( ) = 0;
